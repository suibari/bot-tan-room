# Server-side VOICEVOX settings (used by this app).
VOICEVOX_DOMAIN=voicevox.suibari.com
CF_ACCESS_CLIENT_ID_VOICEVOX=
CF_ACCESS_CLIENT_SECRET_VOICEVOX=
# Optional tts.quest fallback API key
VOICEVOX_API_KEY=

# Server-side TTS settings (also set in Cloudflare Pages production/preview).
TTS_DOMAIN=tts.suibari.com
CF_ACCESS_CLIENT_ID_TTS=
CF_ACCESS_CLIENT_SECRET_TTS=
# During migration, existing CF_ACCESS_CLIENT_ID_VOICEVOX and
# CF_ACCESS_CLIENT_SECRET_VOICEVOX are accepted if the new keys are absent.
